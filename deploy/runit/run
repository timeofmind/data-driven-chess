#!/bin/sh
# runit service: Chess, one node of two (Caddy + datadriven handler), behind nginx.
# install.sh writes one copy per node with CHESS_NODE, CHESS_PORT and CHESS_CLUSTER_PORT set.
exec 2>&1
export CHESS_NODE=${CHESS_NODE:-n1}
export CHESS_PORT=${CHESS_PORT:-8110}
export CHESS_CLUSTER_PORT=${CHESS_CLUSTER_PORT:-9111}
export CHESS_APP=/etc/chess/app
export CHESS_DB=/var/lib/chess/players.db
export CHESS_DATA=/var/lib/chess
export CHESS_TOKEN_KEY=/etc/chess/token.key
export CHESS_BIND=127.0.0.1
# Outgoing mail through the host's exim4 (trusts localhost: no authentication).
export CHESS_SMTP_HOST=${CHESS_SMTP_HOST:-127.0.0.1}
export CHESS_SMTP_PORT=${CHESS_SMTP_PORT:-25}
export CHESS_MAIL_FROM=${CHESS_MAIL_FROM:-chess@holmgren.ca}
# Admins: login emails, space-separated, in a server-only file (not in this repository).
export CHESS_ADMINS="$(cat /etc/chess/admins 2>/dev/null)"
# Secrets (the coach's CHESS_CLAUDE_KEY): a server-only file of export lines, root:chess 640.
[ -r /etc/chess/env ] && . /etc/chess/env
export HOME=/var/lib/chess
export XDG_DATA_HOME=/var/lib/chess/caddy/$CHESS_NODE
export XDG_CONFIG_HOME=/var/lib/chess/caddy/$CHESS_NODE
exec chpst -u chess:chess /usr/local/bin/caddy-chess run --config /etc/chess/Caddyfile --adapter caddyfile
